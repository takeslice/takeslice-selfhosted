# Infrastructure only. Everything a business edits (SMTP, providers, commission rules)
# lives in the database and is changed from the admin dashboard after setup.

DATABASE_URL=postgres://takeslice:takeslice@db:5432/takeslice
APP_URL=http://localhost:3000

# Generated automatically on first boot when unset (stored in the data volume).
# For a manual install generate them yourself:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# Optional. When unset a one-time setup token is generated and printed to the logs.
SETUP_TOKEN=

PORT=3000
TRUST_PROXY=false
LOG_LEVEL=info
