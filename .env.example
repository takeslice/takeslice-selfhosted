# Infrastructure only. Everything a business edits (SMTP, providers, commission rules)
# lives in the database and is changed from the admin dashboard after setup.
#
# Generate a working .env with a random database password and secrets:
#   ./scripts/init-env.sh https://affiliates.example.com
#
# Docker Compose refuses to start while POSTGRES_PASSWORD is empty.

POSTGRES_USER=takeslice
POSTGRES_PASSWORD=
POSTGRES_DB=takeslice

# Used by local development (pnpm dev). Compose builds its own URL from the
# POSTGRES_* values above; set this to localhost:5432 for pnpm dev.
DATABASE_URL=postgres://takeslice:CHANGE_ME@db:5432/takeslice

APP_URL=http://localhost:3000
APP_PORT=3000

# Generated automatically on first boot when unset (stored in the data volume).
# For a manual install generate them yourself:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# Optional. When unset a one-time setup token is generated and printed to the logs.
SETUP_TOKEN=

PORT=3000
# Enable only behind a reverse proxy that appends the client address to X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated CIDRs treated as trusted proxy hops. Defaults to loopback and private ranges.
# Narrow this to your proxy's actual address, for example:
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.18.0.0/16
LOG_LEVEL=info
